<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Projeto_GerenciamentoDeUsuarios"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="Projeto_GerenciamentoDeUsuarios.StartScreen"
    mc:Ignorable="d"
    Title="Sistema GEARU"
    MinWidth="1300"
    MinHeight="800"
    Background="#F7F7F7"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    Closing="Window_Closing">


    <Window.Resources>

        <!-- CORES -->

        <SolidColorBrush x:Key="WindowBackground" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="SidebarBackground" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SidebarSelected" Color="#DCEBFF"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0067C0"/>
        <SolidColorBrush x:Key="PrimaryButtonText" Color="White"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#616161"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="White"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="DarkGray"/>
        <SolidColorBrush x:Key="ButtonText" Color="Black"/>


        <!-- SOMBRA -->

        <DropShadowEffect
            x:Key="SoftShadow"
            BlurRadius="18"
            ShadowDepth="2"
            Direction="270"
            Opacity="0.12"
            Color="#000000"/>


        <!-- BOTÃO DO MENU -->

        <Style x:Key="MenuButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource SidebarHover}"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource ButtonBorder}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- BOTÃO PRINCIPAL -->

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="{DynamicResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1976D2"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#005A9E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- TEXTBOX -->

        <Style TargetType="TextBox">

            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>


        <!-- COMBOBOX -->

        <Style TargetType="ComboBox">

            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource SidebarSelected}"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="BorderThickness" Value="1"/>

        </Style>


        <!-- LABEL -->

        <Style TargetType="Label">

            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>

        </Style>

    </Window.Resources>


    <!-- LAYOUT PRINCIPAL -->

    <Grid Background="{DynamicResource WindowBackground}">

        <Grid.ColumnDefinitions>

            <!-- MENU -->

            <ColumnDefinition Width="210"/>

            <!-- CONTEÚDO -->

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="80"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="65"/>

                </Grid.RowDefinitions>


                <!-- LOGO -->

                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="18,0">

                    <Border
                        Width="40"
                        Height="40"
                        Background= "{DynamicResource PrimaryBlue}"
                        CornerRadius="10">

                        <TextBlock
                            Text="G"
                            Foreground="{DynamicResource PrimaryButtonText}"
                            FontSize="20"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="GEARU"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock
                            Text="Gestão de usuários"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"/>

                    </StackPanel>

                </StackPanel>


                <!-- MENU -->

                <StackPanel
                    x:Name="side_menu"
                    Grid.Row="1"
                    Margin="4,12,4,0">

                    <!-- PROFILE -->

                    <Button
                        x:Name="menu_button_edit"
                        Style="{DynamicResource MenuButtonStyle}"
                        Click="edit_click"
                        Width="182"
                        Height="72"
                        HorizontalAlignment="Left">

                        <Grid Width="170">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PROFILE IMAGE -->

                            <Grid
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">

                                <!-- Border / background -->
                                <Ellipse
                                    Fill="White"
                                    Stroke="#D0D0D0"
                                    StrokeThickness="1"/>

                                <!-- User image -->
                                <Ellipse Margin="3">

                                    <Ellipse.Fill>
                                        <ImageBrush
                                            x:Name="profile_image"
                                            ImageSource="/ProfileImage/0.png"
                                            Stretch="UniformToFill"
                                            AlignmentX="Center"
                                            AlignmentY="Center"/>
                                    </Ellipse.Fill>

                                </Ellipse>

                            </Grid>

                            <!-- PROFILE TEXT -->

                            <TextBlock
                                HorizontalAlignment="Left"
                                x:Name="profile_text"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="Perfil de Usuário" Grid.ColumnSpan="2" Margin="45,0,0,0"/>

                        </Grid>

                    </Button>


                    <!-- INÍCIO -->

                    <Button
                        x:Name="menu_button_start"
                        Style="{DynamicResource MenuButtonStyle}"
                        Click="start_click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="🏠"
                                FontSize="21"
                                Width="35"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text="Início"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <!-- REGISTRAR -->

                    <Button
                        x:Name="menu_button_register"
                        Style="{DynamicResource MenuButtonStyle}"
                        Click="register_click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="➕"
                                FontSize="21"
                                Width="35"
                                VerticalAlignment="Center"/>

                            <TextBlock Text="Registrar Usuários"/>

                        </StackPanel>

                    </Button>

                    <!-- REMOVER -->

                    <Button
                        x:Name="menu_button_remove"
                        Style="{DynamicResource MenuButtonStyle}"
                        Click="remove_click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="🗑️"
                                FontSize="19"
                                Width="35"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                VerticalAlignment="Center"><Run Text="Remover"/><Run Language="pt-br" Text=" Usuários"/></TextBlock>

                        </StackPanel>

                    </Button>


                    <!-- SWITCH THEME -->

                    <Button
                        x:Name="menu_button_switch"
                        Style="{DynamicResource MenuButtonStyle}">
                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                FontSize="19"
                                Width="35"
                                VerticalAlignment="Center"><Run Language="pt-br" Text="🌓"/></TextBlock>
                            <ui:ToggleSwitch x:Name="BotaoDarkMode" Content="Dark Mode" Checked="BotaoDarkMode_Checked" Unchecked="BotaoDarkMode_Unchecked" Foreground="Black" Height="58" Width="140" IsChecked="False" >
                                <ui:ToggleSwitch.Background>
                                    <SolidColorBrush Color="#FF5D5D5D"/>
                                </ui:ToggleSwitch.Background>
                            </ui:ToggleSwitch>

                        </StackPanel>

                    </Button>
                    <Button
                        x:Name="menu_button_switch_savelogin"
                        Style="{DynamicResource MenuButtonStyle}" Width="195">
                        <StackPanel Orientation="Horizontal" Width="177">

                            <TextBlock
                                FontSize="19"
                                Width="35"
                                VerticalAlignment="Center"><Run Language="pt-br" Text="💾"/></TextBlock>
                            <ui:ToggleSwitch x:Name="BotaoSaveLogin" Content="Guardar Login" Checked="BotaoSaveLogin_Checked" Unchecked="BotaoSaveLogin_Unchecked" Foreground="{DynamicResource TextPrimary}" Height="58" Width="143" IsChecked="False" >
                                <ui:ToggleSwitch.Background>
                                    <SolidColorBrush Color="#FF5D5D5D"/>
                                </ui:ToggleSwitch.Background>
                            </ui:ToggleSwitch>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <!-- SAIR -->

                <Border
                    Grid.Row="2"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,1,0,0">

                    <Button
                        x:Name="menu_button_exit"
                        Style="{DynamicResource MenuButtonStyle}"
                        Click="exit_click"
                        Margin="8">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="❌"
                                FontSize="19"
                                Width="29"
                                VerticalAlignment="Center" Height="24"/>

                            <TextBlock
                                VerticalAlignment="Center" FontSize="18"><Run Text="Sair"/><Run Language="pt-br" Text=" do Sistema"/></TextBlock>

                        </StackPanel>

                    </Button>

                </Border>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- CONTEÚDO -->
        <!-- ================================================= -->

        <Grid x:Name="main_grid"
            Grid.Column="1"
            Background="{DynamicResource WindowBackground}">


            <!-- ============================================= -->
            <!-- REGISTER -->
            <!-- ============================================= -->

            <Grid
                x:Name="register_screen"
                Visibility="Collapsed">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto">
                    <StackPanel
                        Width="500"
                        HorizontalAlignment="Center"
                        Margin="40">

                        <TextBlock
                            Text="Registrar novo Usuário"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Margin="0,10,0,5"/>

                        <TextBlock
                            Text="Cadastre um novo usuário no sistema."
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondary}"
                            Margin="0,0,0,30"/>


                        <!-- CARD -->

                        <Border
                            Background="{DynamicResource ButtonBackground}"
                            CornerRadius="12"
                            Padding="30"
                            Effect="{DynamicResource SoftShadow}">

                            <StackPanel>
                                <Button
                                    x:Name="create_user"
                                    Click="create_user_click"
                                    Content="Criar Usuário"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Height="44"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>


            <!-- ============================================= -->
            <!-- PROFILE -->
            <!-- ============================================= -->

            <Grid
                x:Name="edit_screen"
                Visibility="Visible">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel
                        Width="650"
                        HorizontalAlignment="Center"
                        Margin="40">

                        <!-- TITLE -->

                        <TextBlock
                            Text="Perfil do Usuário"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Margin="0,10,0,5"/>

                        <TextBlock
                            Text="Visualize e gerencie as informações da sua conta."
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondary}"
                            Margin="0,0,0,30"/>


                        <!-- PROFILE CARD -->

                        <Border
                            Background="{DynamicResource ButtonBackground}"
                            CornerRadius="12"
                            Padding="32"
                            Effect="{DynamicResource SoftShadow}">

                            <StackPanel>

                                <!-- PROFILE HEADER -->

                                <StackPanel
                                    Orientation="Horizontal"
                                    Margin="0,0,0,30">

                                    <!-- PROFILE IMAGE -->

                                    <Grid
                                        Width="90"
                                        Height="90">

                                        <Ellipse
                                            Fill="White"
                                            Stroke="{DynamicResource BorderColor}"
                                            StrokeThickness="2"/>

                                        <Ellipse
                                            Margin="5">

                                            <Ellipse.Fill>

                                                <ImageBrush
                                                    x:Name="profile_page_image"
                                                    ImageSource="/ProfileImage/0.png"
                                                    Stretch="UniformToFill"
                                                    AlignmentX="Center"
                                                    AlignmentY="Center"/>

                                            </Ellipse.Fill>

                                        </Ellipse>

                                    </Grid>


                                    <!-- NAME -->

                                    <StackPanel
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center">

                                        <Grid>
                                            <TextBlock
                                            x:Name="profile_fullname"
                                            Text="Nome Completo"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBox x:Name="edit_profile_fullname" 
                                                     Text="Nome Completo" 
                                                     Padding="0,0,0,0" 
                                                     FontWeight="Bold" 
                                                     FontSize="22" 
                                                     HorizontalAlignment="Center" 
                                                     VerticalAlignment="Center" 
                                                     Height="45" 
                                                     Visibility="Collapsed"
                                                     />
                                        </Grid>
                                        <TextBlock
                                            x:Name="profile_username"
                                            Text="@usuario"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Margin="0,4,0,0"/>

                                        <Border
                                            Background="{DynamicResource SidebarSelected}"
                                            CornerRadius="6"
                                            HorizontalAlignment="Left"
                                            Padding="8,3"
                                            Margin="0,8,0,0">

                                            <TextBlock
                                                x:Name="profile_account_type"
                                                Text="Usuário"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimary}"/>

                                        </Border>

                                    </StackPanel>

                                </StackPanel>


                                <!-- SEPARATOR -->

                                <Border
                                    Height="1"
                                    Background="{DynamicResource BorderColor}"
                                    Margin="0,0,0,25"/>


                                <!-- INFORMATION -->

                                <TextBlock
                                    Text="Informações da conta"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Margin="0,0,0,18"/>


                                <!-- EMAIL -->

                                <Grid Margin="0,0,0,15">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="E-mail"
                                        Foreground="{DynamicResource TextSecondary}"
                                        FontSize="13"/>

                                    <TextBlock
                                        x:Name="profile_email"
                                        Grid.Column="1"
                                        Text="email@email.com"
                                        Foreground="{DynamicResource TextPrimary}"
                                        FontSize="14"/>
                                    <TextBox x:Name="edit_profile_email" Margin="133,0,303,0" Text="email@email.com" Grid.ColumnSpan="2" Visibility="Collapsed"/>
                                </Grid>


                                <!-- USER -->

                                <Grid Margin="0,0,0,15">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="Usuário"
                                        Foreground="{DynamicResource TextSecondary}"
                                        FontSize="13"/>

                                    <TextBlock
                                        x:Name="profile_user"
                                        Grid.Column="1"
                                        Text="usuario"
                                        Foreground="{DynamicResource TextPrimary}"
                                        FontSize="14"/>
                                    <TextBox x:Name="edit_profile_user" Margin="134,0,302,0" Text="usuario" Grid.ColumnSpan="2" Visibility="Collapsed"/>

                                </Grid>


                                <!-- ACCOUNT TYPE -->

                                <Grid Margin="0,0,0,15">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="Tipo de conta"
                                        Foreground="{DynamicResource TextSecondary}"
                                        FontSize="13"/>

                                    <TextBlock
                                        x:Name="profile_type"
                                        Grid.Column="1"
                                        Text="Usuário"
                                        Foreground="{DynamicResource TextPrimary}"
                                        FontSize="14"/>
                                    <ComboBox x:Name="edit_profile_type" Margin="134,2,302,-2" Grid.ColumnSpan="2" Visibility="Collapsed"/>
                                </Grid>


                                <!-- LAST ACTIVITY -->

                                <Grid Margin="0,0,0,25">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Text="Última atividade"
                                        Foreground="{DynamicResource TextSecondary}"
                                        FontSize="13"/>

                                    <TextBlock
                                        x:Name="profile_last_active"
                                        Grid.Column="1"
                                        Text="Online agora"
                                        Foreground="{DynamicResource TextPrimary}"
                                        FontSize="14"/>

                                </Grid>


                                <!-- ACTION -->
                                <Grid>
                                    <Button
                                    x:Name="edit_profile_button"
                                    Content="Editar Perfil"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Width="150"
                                    Height="42"
                                    HorizontalAlignment="Left" Click="edit_profile_button_Click" Visibility="Visible"/>
                                    <Button
                                    x:Name="cancel_edit_profile_button"
                                    Content="Cancelar"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Width="150"
                                    Height="42"
                                    HorizontalAlignment="Left" Click="cancel_edit_profile_button_Click" Visibility="Collapsed"/>
                                    <Button
                                    x:Name="save_edit_profile_button"
                                    Content="Salvar Edição"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Width="150"
                                    Height="42"
                                    HorizontalAlignment="Left" Margin="169,0,0,0" Click="save_edit_profile_button_Click" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

            <!-- ============================================= -->
            <!-- LANDING PAGE -->
            <!-- ============================================= -->

            <Grid
                x:Name="landing_page"
                Visibility="Collapsed">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="970"
                    Margin="0,50,0,0">

                    <TextBlock
                        x:Name="title_landing_page"
                        FontSize="30"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextPrimary}"><Run Text="Bem-vindo "/><Run Language="pt-br" Text="ao Sistema "/></TextBlock>

                    <TextBlock
                        Foreground="{DynamicResource TextSecondary}"
                        FontSize="14"
                        HorizontalAlignment="Center"
                        Margin="0,7,0,30"><Run Language="pt-br" Text="Visualize os Usuários do sistema"/><Run Text="."/></TextBlock>
                    <Border
                        Background="{DynamicResource ButtonBackground}"
                        CornerRadius="19,19,19,19"
                        Padding="15"
                        Effect="{DynamicResource SoftShadow}" Width="970">
                        <ScrollViewer 
                            HorizontalScrollBarVisibility="Disabled" 
                            VerticalScrollBarVisibility="Visible" Height="518" >
                            <WrapPanel x:Name="ContainerDeCards" Margin="10" Width="970"/>

                        </ScrollViewer>

                    </Border>


                    <Button
                        x:Name="menu_button_register_first_house"
                        Content="➕ Registar novo Usuário"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Width="230"
                        Height="45"
                        HorizontalAlignment="Center"
                        Margin="0,25,0,0"
                        Click="register_click"/>

                </StackPanel>

            </Grid>


            <!-- ============================================= -->
            <!-- REMOVE -->
            <!-- ============================================= -->

            <Grid
                x:Name="remove_screen"
                Visibility="Collapsed">

                <StackPanel
                    Width="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="50">

                    <TextBlock
                        x:Name="title_remove"
                        FontSize="30"
                        FontWeight="SemiBold"><Run Text="Remoção de Usuários"
                        Foreground="{DynamicResource TextPrimary}" />
                    </TextBlock>

                    <TextBlock
                        Foreground="{DynamicResource TextSecondary}"
                        Margin="0,5,0,30"><Run Text="Escolha uma ação"/><Run Language="pt-br" Text=" a seguir:"/></TextBlock>


                    <Border x:Name="border"
                        Background="{DynamicResource ButtonBackground}"
                        CornerRadius="12"
                        Padding="30"
                        Effect="{DynamicResource SoftShadow}">

                        <StackPanel>

                            <Button
                                x:Name="remove_user_button"
                                Content="Remover um usuário do Sistema"
                                Height="45"
                                Background="{DynamicResource PrimaryBlue}"
                                BorderThickness="0"
                                Click="remove_user_button_Click" Width="540"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </Grid>


    </Grid>

</Window>
