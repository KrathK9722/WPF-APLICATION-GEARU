<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_GerenciamentoDeUsuarios"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Projeto_GerenciamentoDeUsuarios.Login_Screen"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="Login"
        Width="1000"
        Height="650"
        MinWidth="850"
        MinHeight="750"
        Background="#F7F7F7"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackground" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0067C0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#707070"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D1D1D1"/>

        <DropShadowEffect
            x:Key="SoftShadow"
            BlurRadius="18"
            ShadowDepth="2"
            Direction="270"
            Opacity="0.12"
            Color="#000000"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1976D2"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#005A9E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="#EDEDED"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#E0E0E0"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#D5D5D5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style TargetType="{x:Type TextBox}">

            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        <Style TargetType="{x:Type Label}">

            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>

        </Style>

    </Window.Resources>

    <Grid x:Name="login_grid" Background="{StaticResource WindowBackground}">

        <Border
            Width="430"
            Padding="40"
            Background="White"
            CornerRadius="14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Effect="{StaticResource SoftShadow}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Width="58"
                    Height="58"
                    Background="{StaticResource PrimaryBlue}"
                    CornerRadius="14"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Foreground="White"
                        FontSize="28"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"><Run Language="pt-br" Text="G"/></TextBlock>

                </Border>

                <TextBlock
                    Grid.Row="1"
                    Text="Fazer login"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimary}"
                    HorizontalAlignment="Center"
                    Margin="0,18,0,5"/>


                <TextBlock
                    Grid.Row="2"
                    FontSize="13"
                    Foreground="{StaticResource TextSecondary}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,28"><Run Text="Entre na sua conta "/><Run Language="pt-br" Text="d"/><Run Text="o GEARU."/></TextBlock>

                <StackPanel Grid.Row="3">

                    <Label
                        Content="Email ou usuário"
                        Padding="0"
                        Margin="0,0,0,7"
                        FontWeight="SemiBold"/>

                    <TextBox
                        x:Name="txt_enter_email_or_user"
                        TextWrapping="Wrap"
                        Foreground="#1A1A1A"
                        SelectionBrush="{StaticResource PrimaryBlue}"/>
                    <Label
                        x:Name="error_wrong_user_or_password"
                        Content="Usuário, Email ou Senha incorretos"
                        Foreground="#B10000"
                        FontSize="11"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel
                    Grid.Row="4"
                    Margin="0,18,0,0">

                    <Label
                        Content="Senha"
                        Padding="0"
                        Margin="0,0,0,7"
                        FontWeight="SemiBold"/>

                    <PasswordBox
                        x:Name="txt_enter_password"
                        Height="42"
                        FontSize="14"
                        Padding="12,8"
                        Foreground="#1A1A1A"
                        Background="White"
                        BorderBrush="#D1D1D1"
                        BorderThickness="1"
                        VerticalContentAlignment="Center"/>
                </StackPanel>
                <Grid x:Name="grid_not_robot" Height="31" Visibility="Visible" Margin="0,15,0,194" Grid.Row="6">
                    <CheckBox                       
                        x:Name="checkbox_not_robot"
                        Content="Não sou um robô."
                        Checked="CheckBox_Checked"
                        IsChecked="False"
                        Foreground="#444444"
                        FontSize="13" Background="#FFC3C3C3" HorizontalAlignment="Center"/>
                </Grid>
                <Grid x:Name="checked_image_grid" Height="31" Visibility="Collapsed" Margin="0,15,0,194" Grid.Row="6">
                    <Image x:Name="checked_image"
                        Source="/DesignImages/image_checked_notrobot.png"
                        Stretch="Uniform" Margin="89,2,80,0"/>
                </Grid>
                <StackPanel
                    Grid.Row="6"
                    Margin="0,45,0,0">
                    <Label
                        x:Name="error_data_not_found"
                        Content="Dados não encontrados no sistema"
                        Foreground="#B10000"
                        FontSize="11"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        Visibility="Collapsed"/>
                    <Label
                        x:Name="error_fill_everything"
                        Content="Preencha todos os campos"
                        Foreground="#B10000"
                        FontSize="11"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        Visibility="Collapsed"/>

                    <Label
                        x:Name="error_verify"
                        Content="Confirme que você não é um robô"
                        Foreground="#B10000"
                        FontSize="11"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        Visibility="Collapsed"/>

                    <Label
                        x:Name="error_system"
                        Content="Erro no sistema"
                        Foreground="#B10000"
                        FontSize="11"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        Visibility="Collapsed"/>

                </StackPanel>

                <StackPanel
                    Grid.Row="6"
                    Margin="0,72,0,72">


                    <Button
                        x:Name="btn_login_account"
                        Content="Fazer Login"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="44"
                        Click="btn_login_account_Click"/>


                    <Button
                        x:Name="btn_sign_in_screen"
                        Content="Fechar Sistema"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="42"
                        Margin="0,10,0,0"
                        Click="close_screen_Click"/>

                </StackPanel>

                <Button
                    x:Name="btn_login_screen"
                    Content="Login"
                    Visibility="Collapsed"/>

            </Grid>

        </Border>

    </Grid>

</Window>