<UserControl x:Class="Projeto_GerenciamentoDeUsuarios.CardVision"
             x:Name="ThisCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Projeto_GerenciamentoDeUsuarios"
             mc:Ignorable="d"
            d:DesignHeight="440"
            d:DesignWidth="280"
            MinWidth="260"
            MinHeight="420">

    <UserControl.Resources>

        <!-- CORES -->
        <SolidColorBrush x:Key="CardBackground" Color="#0000000D"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E3E4F7"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#202124"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#777982"/>
        <SolidColorBrush x:Key="AccentColor" Color="#5145D9"/>

        <!-- BOTÃO PRINCIPAL -->
        <Style x:Key="ProfileButton" TargetType="Button">
            <Setter Property="Background" Value="#5145D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#4034BD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÃO SECUNDÁRIO -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F7"/>
            <Setter Property="Foreground" Value="#292929"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E5E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder"
                                        Property="Background"
                                        Value="#E9E9EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- CARTÃO EXTERNO -->
    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="25"
            Padding="5">

        <Border.Effect>
            <DropShadowEffect Color="#777777"
                              Opacity="0.16"
                              BlurRadius="16"
                              ShadowDepth="4"
                              Direction="270"/>
        </Border.Effect>

        <Border Background="{DynamicResource CardBackground}"
                CornerRadius="21"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="130"/>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- BANNER SUPERIOR -->
                <Grid Grid.Row="0" ClipToBounds="True">
                    <Border CornerRadius="18,18,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#FFB74D"
                                              Offset="0"/>
                                <GradientStop Color="#EC4C78"
                                              Offset="0.35"/>
                                <GradientStop Color="#7B36C9"
                                              Offset="0.65"/>
                                <GradientStop Color="#0066A8"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- FORMAS DECORATIVAS -->
                    <Ellipse Width="190"
                             Height="190"
                             Fill="#55FFFFFF"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,-105,-55,0"/>

                    <Ellipse Width="130"
                             Height="180"
                             Fill="#33002070"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Bottom"
                             Margin="-65,0,0,-80"/>

                    <Path Data="M 0,0 L 80,0 L 180,130 L 100,130 Z"
                          Fill="#44FFFFFF"
                          Stretch="Fill"
                          HorizontalAlignment="Right"
                          Width="150"
                          Height="130"/>

                    <!-- STATUS -->
                    <Border Background="#EFFFFFFF"
                            CornerRadius="12"
                            Padding="7,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,12,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{Binding CardOnlineColor, ElementName=ThisCard}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CardAccountStatus, ElementName=ThisCard}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding CardOnlineColor, ElementName=ThisCard}">

                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FOTO E NOME -->
                <Grid Grid.Row="1">

                    <!-- FOTO DE PERFIL SOBREPOSTA -->
                    <Grid Width="80"
                          Height="80"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="16,-38,0,0"
                          Panel.ZIndex="2">

                        <Ellipse Fill="White"/>

                        <Ellipse Margin="5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding CardImageSource, ElementName=ThisCard}"
                                            Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- INDICADOR -->
                        <Ellipse Width="13"
                                 Height="13"
                                 Fill="{Binding CardOnlineColor, ElementName=ThisCard}"
                                 Stroke="White"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,3"/>
                    </Grid>

                    <!-- NOME E TIPO -->
                    <StackPanel Margin="105,9,8,0"
                                VerticalAlignment="Top">


                        <!-- NOME DE USUÁRIO -->
                        <Grid>
                            <TextBlock x:Name="CardUserText"
                           Text="{Binding CardUser, ElementName=ThisCard}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#202124"
                           TextTrimming="CharacterEllipsis"/>

                            <TextBox x:Name="CardEditUser"
                             Height="32"
                             FontSize="12"
                             Foreground="#202124"
                             Background="White"
                             BorderBrush="#CFCFCF"
                             Visibility="Collapsed"/>
                        </Grid>

                        <TextBlock Text="{Binding CardLastTimeActive,ElementName=ThisCard}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   MaxHeight="34"/>
                    </StackPanel>

                    <!-- MENU VISUAL -->
                </Grid>

                <!-- DIVISÓRIA -->
                <Border Grid.Row="2"
                        BorderBrush="#EEEEF0"
                        BorderThickness="0,1,0,1"
                        Background="#0000000D">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TIPO -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Perfil"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"/>

                            <Grid>
                                <TextBlock x:Name="CardTypeText"
                               Text="{Binding CardUserType, ElementName=ThisCard}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#202124"
                               HorizontalAlignment="Center"/>

                                <ComboBox x:Name="CardEditType"
                              Width="110"
                              Height="30"
                              FontSize="11"
                              Foreground="#202124"
                              Background="White"
                              BorderBrush="#CFCFCF"
                              Visibility="Collapsed">
                                    <ComboBoxItem Content="Usuário"/>
                                    <ComboBoxItem Content="Administrador"/>
                                </ComboBox>
                            </Grid>

                        </StackPanel>

                        <!-- DIVISÓRIA VERTICAL -->
                        <Border Grid.Column="1"
                                BorderBrush="#E8E8EA"
                                BorderThickness="1,0,0,0"
                                Margin="0,12,0,12"/>

                        <!-- STATUS -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock
                                       FontSize="15"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"><Run Language="pt-br" Text="Status"/></TextBlock>
                            <TextBlock Text="{Binding CardAccountBanned,ElementName=ThisCard}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- INFORMAÇÕES -->
                <StackPanel Grid.Row="3" Margin="16,13,16,8">

                    <!-- NOME COMPLETO -->
                    <TextBlock Text="Nome Completo"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="#202124"
                   Margin="0,0,0,5"/>

                    <Grid Margin="0,0,0,12">

                        <TextBlock x:Name="CardFullNameText"
                       Text="{Binding CardFullName, ElementName=ThisCard}"
                       FontSize="12"
                       Foreground="#444444"
                       TextWrapping="Wrap"/>

                        <TextBox x:Name="CardEditFullName"
                         Height="34"
                         FontSize="12"
                         Foreground="#202124"
                         Background="White"
                         BorderBrush="#CFCFCF"
                         Visibility="Collapsed"/>

                    </Grid>

                    <!-- EMAIL -->
                    <TextBlock Text="E-mail"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#202124"
                   Margin="0,0,0,5"/>

                    <Grid Margin="0,0,0,12">

                        <TextBlock x:Name="CardEmailText"
                       Text="{Binding CardEmail, ElementName=ThisCard}"
                       FontSize="12"
                       Foreground="#444444"
                       TextWrapping="Wrap"/>

                        <TextBox x:Name="CardEditEmail"
                         Height="34"
                         FontSize="12"
                         Foreground="#202124"
                         Background="White"
                         BorderBrush="#CFCFCF"
                         Visibility="Collapsed"/>

                    </Grid>

                    <!-- BANIMENTO -->
                    <Button x:Name="CardBanButton"
                    Height="36"
                    Margin="0,12,0,0"
                    Background="#C62828"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="CardBanButton_Click">

                        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

                            <TextBlock x:Name="BanButtonIcon"
                       Text="🚩"
                       FontSize="15"
                       Margin="0,0,8,0"/>

                            <TextBlock x:Name="BanButtonText"
                       Text="Banir usuário"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                </StackPanel>



                <!-- RODAPÉ -->
                <Grid Grid.Row="4" Margin="12,8,12,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <!-- VISUALIZAR -->
                    <Button x:Name="CardButton"
                Grid.Column="0"
                Content="Visualizar perfil"
                Style="{StaticResource ProfileButton}"
                Visibility="{Binding CardOpenClickVisibility, ElementName=ThisCard}"
                Click="Card_Click" Grid.ColumnSpan="3"/>

                    <!-- FECHAR -->
                    <Button x:Name="CardCloseButton"
                Grid.Column="0"
                Content="Fechar Perfil"
                Style="{StaticResource ProfileButton}"
                Visibility="{Binding CardCloseClickVisibility, ElementName=ThisCard}"
                Click="Card_Close_Click" Grid.ColumnSpan="3"/>

                    <!-- BOTÃO ABRIR -->

                    <!-- BOTÃO EDITAR -->
                    <Button x:Name="CardEditButton"
                Grid.Column="2"
                Style="{StaticResource SecondaryButton}"
                Visibility="{Binding CardEditVisibility, ElementName=ThisCard}"
                Click="CardEditButton_Click"
                ToolTip="Editar usuário" Margin="55,0,0,0">

                        <Viewbox Width="20" Height="20">
                            <Path Stroke="#243746"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M3,21 L7,20 L20,7
                                L17,4 L4,17 Z
                                M15,6 L18,9"/>
                        </Viewbox>
                    </Button>

                    <!-- CANCELAR -->
                    <Button x:Name="CardCancelEditButton"
                Grid.Column="0"
                Content="Cancelar"
                Style="{StaticResource SecondaryButton}"
                Visibility="Collapsed"
                Margin="0,0,8,0"
                Click="CardCancelEditButton_Click"/>

                    <!-- SALVAR -->
                    <Button x:Name="CardSaveEditButton"
                Grid.Column="2"
                Content="Salvar"
                Style="{StaticResource ProfileButton}"
                Visibility="Collapsed"
                Click="CardSaveEditButton_Click"/>
                </Grid>

            </Grid>
        </Border>
    </Border>
</UserControl>