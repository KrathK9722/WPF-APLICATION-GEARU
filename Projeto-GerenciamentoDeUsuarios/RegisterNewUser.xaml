<Window xmlns:Controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"  x:Class="Projeto_GerenciamentoDeUsuarios.RegisterNewUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_GerenciamentoDeUsuarios"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Registrar Usuário no GEARU"
        MinWidth="430"
        MinHeight="815"
        MaxHeight="815"
        MaxWidth="430"
        FontFamily="Segoe UI"
        WindowStyle="ToolWindow"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>

        <!-- ================================================= -->
        <!-- CORES -->
        <!-- ================================================= -->

        <SolidColorBrush x:Key="WindowBackground" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0067C0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#707070"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D1D1D1"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="DarkGray"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#E8E8E8"/>

        <Style x:Key="MenuButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="LightGray"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}" BorderBrush="#FF484848">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="LightGray"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="WhiteSmoke"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- SOMBRA -->
        <!-- ================================================= -->

        <DropShadowEffect
            x:Key="SoftShadow"
            BlurRadius="18"
            ShadowDepth="2"
            Direction="270"
            Opacity="0.12"
            Color="#000000"/>


        <!-- ================================================= -->
        <!-- BOTÃO PRINCIPAL -->
        <!-- ================================================= -->

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1976D2"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#005A9E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- BOTÃO SECUNDÁRIO -->
        <!-- ================================================= -->

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#E0E0E0"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#D5D5D5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ================================================= -->
        <!-- TEXTBOX -->
        <!-- ================================================= -->

        <Style TargetType="TextBox">

            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D1D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>


        <!-- ================================================= -->
        <!-- LABEL -->
        <!-- ================================================= -->

        <Style TargetType="Label">

            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>

        </Style>

    </Window.Resources>


    <!-- ===================================================== -->
    <!-- ÁREA PRINCIPAL -->
    <!-- ================================================= -->

    <Grid x:Name="register_grid" Height="800" VerticalAlignment="Center" Margin="0,0,0,0" Width="430">
        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <!-- ================================================= -->
            <!-- CARD DE CADASTRO -->
            <!-- ================================================= -->

            <Border
                    Padding="40"
                    Background="White"
                    CornerRadius="14"
                    Effect="{StaticResource SoftShadow}"
                    Margin="0,0,5,1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- LOGO -->
                    <!-- ================================================= -->

                    <Border
                            Grid.Row="0"
                            Width="58"
                            Height="58"
                            Background="{StaticResource PrimaryBlue}"
                            CornerRadius="14"
                            HorizontalAlignment="Center">

                        <TextBlock
                                Foreground="White"
                                FontSize="28"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"><Run Language="pt-br" Text="G"/></TextBlock>

                    </Border>


                    <!-- ================================================= -->
                    <!-- TÍTULO -->
                    <!-- ================================================= -->

                    <TextBlock x:Name="title_create_account"
                            Grid.Row="1"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimary}"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,5"><Run Text="Cri"/><Run Language="pt-br" Text="a"/><Run Text="r"/><Run Language="pt-br" Text=" novo Usuário"/></TextBlock>


                    <TextBlock
                            Grid.Row="2"
                            FontSize="13"
                            Foreground="{StaticResource TextSecondary}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28" Height="17" VerticalAlignment="Bottom"><Run Text="Cri"/><Run Language="pt-br" Text="ar novo Usuário no"/><Run Text=" GEARU."/></TextBlock>


                    <!-- ================================================= -->
                    <!-- USUÁRIO -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="2">

                        <Label
                                Content="Usuário"
                                Padding="0"
                                Margin="0,0,0,7"
                                FontWeight="SemiBold"/>

                        <TextBox
                                x:Name="txt_create_user"
                                TextWrapping="Wrap"
                                Foreground="#1A1A1A"
                                SelectionBrush="{StaticResource PrimaryBlue}"/>


                        <Label
                                x:Name="error_create_user"
                                Content="Usuário deve conter 3 ou mais caracteres"
                                Foreground="#B10000"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Margin="0,5,0,0"
                                Visibility="Collapsed"/>


                        <Label
                                x:Name="error_duplicated_user"
                                Content="Este usuário já está sendo utilizado"
                                Foreground="#B10000"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Margin="0,5,0,0"
                                Visibility="Collapsed"/>

                    </StackPanel>

                    <!--==================================================-->
                    <!-- NOME COMPLETO -->
                    <!-- =================================================-->
                    <StackPanel Grid.Row="3" Margin="0,18,0,0">

                        <Label
                                Content="Nome Completo"
                                Padding="0"
                                Margin="0,0,0,7"
                                FontWeight="SemiBold"/>

                        <TextBox
                                x:Name="txt_enter_full_name"
                                TextWrapping="Wrap"
                                Foreground="#1A1A1A"
                                SelectionBrush="{StaticResource PrimaryBlue}"/>


                        <Label
                                x:Name="error_enter_full_name"
                                Content="Insira um nome válido"
                                Foreground="#B10000"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Margin="0,5,0,0"
                                Visibility="Collapsed"/>

                    </StackPanel>
                    <!-- ================================================= -->
                    <!-- EMAIL -->
                    <!-- ================================================= -->

                    <StackPanel
                            Grid.Row="4"
                            Margin="0,18,0,0">

                        <Label
                                Content="Email"
                                Padding="0"
                                Margin="0,0,0,7"
                                FontWeight="SemiBold"/>

                        <TextBox
                                x:Name="txt_create_email"
                                TextWrapping="Wrap"
                                Foreground="#1A1A1A"
                                SelectionBrush="{StaticResource PrimaryBlue}"/>


                        <Label
                                x:Name="error_create_email"
                                Content="Email inválido"
                                Foreground="#B10000"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Margin="0,5,0,0"
                                Visibility="Collapsed"/>


                        <Label
                                x:Name="error_duplicated_email"
                                Content="Este Email já está em uso"
                                Foreground="#B10000"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Margin="0,5,0,0"
                                Visibility="Collapsed"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- SENHA -->
                    <!-- ================================================= -->

                    <StackPanel
                            Grid.Row="5"
                            Margin="0,18,0,0">

                        <Label
                                Content="Criar senha"
                                Padding="0"
                                Margin="0,0,0,7"
                                FontWeight="SemiBold"/>

                        <PasswordBox
                                x:Name="txt_create_password"
                                Height="42"
                                FontSize="14"
                                Padding="12,8"
                                Foreground="#1A1A1A"
                                Background="White"
                                BorderBrush="#D1D1D1"
                                BorderThickness="1"
                                VerticalContentAlignment="Center"/>


                        <Label
                                x:Name="error_create_password"
                                Content="Senha deve conter 8 caracteres ou mais"
                                Foreground="#B10000"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Margin="0,5,0,0"
                                Visibility="Collapsed"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- REPETIR SENHA -->
                    <!-- ================================================= -->

                    <StackPanel
                            Grid.Row="6"
                            Margin="0,18,0,0">

                        <Label
                                Content="Digite a senha novamente"
                                Padding="0"
                                Margin="0,0,0,7"
                                FontWeight="SemiBold"/>

                        <PasswordBox
                                x:Name="txt_register_password"
                                Height="42"
                                FontSize="14"
                                Padding="12,8"
                                Foreground="#1A1A1A"
                                Background="White"
                                BorderBrush="#D1D1D1"
                                BorderThickness="1"
                                VerticalContentAlignment="Center"/>


                        <Label
                                x:Name="error_repeat_password"
                                Content="Senhas não coincidem"
                                Foreground="#B10000"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Margin="0,5,0,0"
                                Visibility="Collapsed"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- AVATAR IMAGE -->
                    <!-- ================================================= -->
                    <StackPanel
                            Grid.Row="7"
                            Margin="0,18,0,0">
                        <Label
                                Content="Escolha um Avatar"
                                Padding="0"
                                Margin="0,0,0,7"
                                FontWeight="SemiBold" HorizontalContentAlignment="Left"/>
                        <Border
                             Background="LightGray"
                             CornerRadius="19,19,19,19"
                             Padding="15"
                             Effect="{DynamicResource SoftShadow}" Width="350">
                            <ScrollViewer 
                                HorizontalScrollBarVisibility="Visible" 
                                VerticalScrollBarVisibility="Disabled" Height="200" Margin="-5,0,-5,0" >
                                <StackPanel
                                    x:Name="ContainerDeCards"
                                    Orientation="Horizontal"
                                    Margin="10">
                                    
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="8"
                        Margin="0,18,0,0">

                        <Button
                            x:Name="menu_button_switch_adminlevel"
                            Style="{DynamicResource MenuButtonStyle}" Width="330"
                            HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Width="330" HorizontalAlignment="Left">

                                <ui:ToggleSwitch HorizontalAlignment="Left" 
                                                 x:Name="button_adminlevel" 
                                                 Content="Usuário de nível Comum" 
                                                 Checked="button_adminlevel_Checked" 
                                                 Unchecked="button_adminlevel_Unchecked"
                                                 Foreground="{DynamicResource TextPrimary}" 
                                                 Height="58" Width="330" 
                                                 IsChecked="False" >
                                    <ui:ToggleSwitch.Resources>

                                    <!-- ============================= -->
                                    <!-- ESTADO NORMAL -->
                                    <!-- ============================= -->

                                     <!-- Bolinha quando ligado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchKnobFillOn"
                                        Color="White"/>

                                     <!-- Bolinha quando desligado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchKnobFillOff"
                                        Color="#F9FAFB"/>

                                     <!-- Fundo quando ligado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchFillOn"
                                        Color="#0A72C7"/>

                                     <!-- Fundo quando desligado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchFillOff"
                                        Color="#D1D5DB"/>

                                     <!-- Borda quando ligado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchStrokeOn"
                                        Color="#0A72C7"/>

                                     <!-- Borda quando desligado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchStrokeOff"
                                        Color="#B8BEC7"/>


                                     <!-- ============================= -->
                                     <!-- HOVER -->
                                     <!-- ============================= -->

                                     <!-- Bolinha desligado + mouse em cima -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchKnobFillOffPointerOver"
                                        Color="White"/>

                                     <!-- Bolinha ligado + mouse em cima -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchKnobFillOnPointerOver"
                                        Color="White"/>

                                     <!-- Fundo desligado + hover -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchFillOffPointerOver"
                                        Color="#C4CAD2"/>

                                     <!-- Fundo ligado + hover -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchFillOnPointerOver"
                                        Color="#0864AE"/>


                                     <!-- ============================= -->
                                     <!-- PRESSIONADO -->
                                     <!-- ============================= -->

                                     <!-- Bolinha desligado pressionado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchKnobFillOffPressed"
                                        Color="#F3F4F6"/>

                                     <!-- Bolinha ligado pressionado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchKnobFillOnPressed"
                                        Color="#F3F4F6"/>

                                     <!-- Fundo desligado pressionado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchFillOffPressed"
                                        Color="#B6BCC5"/>

                                     <!-- Fundo ligado pressionado -->
                                        <SolidColorBrush
                                        x:Key="ToggleSwitchFillOnPressed"
                                        Color="#075997"/>

                                    </ui:ToggleSwitch.Resources>
                                </ui:ToggleSwitch>

                            </StackPanel>

                        </Button>

                    </StackPanel>
                     
                    <!-- ================================================= -->
                    <!-- ERRO GERAL -->
                    <!-- ================================================= -->

                    <StackPanel
                            Grid.Row="9"
                            Margin="0,15,0,0">

                        <Label
                                x:Name="error_fill_everything"
                                Content="Preencha todos os campos para continuar"
                                Foreground="#B10000"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Visibility="Collapsed"/>


                        <Label
                                x:Name="error_system"
                                Content="Erro no sistema, tente novamente."
                                Foreground="#B10000"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Padding="0"
                                Visibility="Collapsed"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- BOTÕES -->
                    <!-- ================================================= -->

                    <StackPanel
                            Grid.Row="10"
                            Margin="0,18,0,0">

                        <Button
                                x:Name="btn_create_account"
                                Content="Criar Conta"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="44"
                                Click="btn_create_account_Click"/>


                        <Button
                                x:Name="btn_comeback_screen"
                                Content="Voltar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="42"
                                Margin="0,10,0,0"
                                Click="comeback_Click"/>

                    </StackPanel>


                </Grid>

            </Border>
            </ScrollViewer>
    </Grid>

</Window>