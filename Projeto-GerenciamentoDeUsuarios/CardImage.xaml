<UserControl x:Class="Projeto_GerenciamentoDeUsuarios.CardImage"
             x:Name="ThisCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Projeto_GerenciamentoDeUsuarios"
             mc:Ignorable="d"
             d:DesignHeight="110"
             d:DesignWidth="110"
             Width="100"
             Height="100">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="White"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E3E4F7"/>
    </UserControl.Resources>

    <Border
        Background="{DynamicResource CardBackground}"
        BorderBrush="{DynamicResource CardBorder}"
        BorderThickness="2"
        CornerRadius="18"
        Padding="6"
        Cursor="Hand"
        MouseLeftButtonDown="Card_Click">

        <Border.Effect>
            <DropShadowEffect
                Color="#777777"
                Opacity="0.15"
                BlurRadius="10"
                ShadowDepth="2"/>
        </Border.Effect>

        <Image
            Source="{Binding CardImageSource, ElementName=ThisCard}"
            Stretch="UniformToFill"/>

    </Border>

</UserControl>